# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_DB=tech_hiring_db

# JWT Configuration
# Must be a Base64 encoded string or a secure string at least 32 bytes long
JWT_SECRET=your_super_secret_jwt_key_that_is_at_least_32_bytes_long

# Email Configuration (for Spring Mail)
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
